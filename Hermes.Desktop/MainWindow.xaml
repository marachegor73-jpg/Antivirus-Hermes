<Window x:Class="Hermes.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="HERMES — защита и порядок" Width="1180" Height="810" MinWidth="1000" MinHeight="700" Background="{StaticResource Base}" Foreground="{StaticResource Ink}" FontFamily="Segoe UI" FontSize="14" WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="215"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="#141617" BorderBrush="{StaticResource Stroke}" BorderThickness="0,0,1,0" Padding="22,30">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top">
          <Viewbox Width="48" Height="58" HorizontalAlignment="Left" Margin="10,0,0,18"><Canvas Width="48" Height="58"><Path Stroke="#B6C8AF" StrokeThickness="1.5" Data="M 24,1 L 44,13 L 41,38 L 24,56 L 7,38 L 4,13 Z M 15,16 L 15,39 M 33,16 L 33,39 M 15,27 L 33,27 M 24,7 L 24,14"/></Canvas></Viewbox>
          <TextBlock Text="H E R M E S" FontFamily="Georgia" FontSize="21" Margin="8,0,0,6"/>
          <TextBlock Text="ЛИЧНЫЙ СТРАЖ" FontSize="9" Foreground="{StaticResource Muted}" Margin="10,0,0,40"/>
          <Button Content="◇     Обзор" Style="{StaticResource Nav}" Tag="0" Click="Navigate"/>
          <Button Content="♜     Антивирус" Style="{StaticResource Nav}" Tag="1" Click="Navigate"/>
          <Button Content="✧     Очистка" Style="{StaticResource Nav}" Tag="2" Click="Navigate"/>
          <Button Content="↗     Процессы" Style="{StaticResource Nav}" Tag="3" Click="Navigate"/>
          <Button Content="♢     Карантин" Style="{StaticResource Nav}" Tag="4" Click="Navigate"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom">
          <Border BorderBrush="{StaticResource Stroke}" BorderThickness="0,1,0,0" Margin="0,30,0,20"/>
          <TextBlock Text="Твой компьютер.&#10;Твоё решение." FontFamily="Georgia" FontSize="16" LineHeight="24"/>
          <TextBlock Text="HERMES / 1.0.0" Foreground="#747C73" FontSize="10" Margin="0,18,0,0"/>
        </StackPanel>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1" Margin="36,26,36,20">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <DockPanel Margin="0,0,0,18"><TextBlock Text="БЕЗОПАСНОСТЬ  /  ОБСЛУЖИВАНИЕ" FontSize="10" Foreground="{StaticResource Muted}"/><TextBlock x:Name="DateText" Text="WINDOWS" FontSize="10" Foreground="{StaticResource Muted}" HorizontalAlignment="Right"/></DockPanel>
      <TabControl x:Name="Pages" Grid.Row="1" SelectedIndex="0" Background="Transparent" BorderThickness="0">
        <TabControl.Template><ControlTemplate TargetType="TabControl"><ContentPresenter ContentSource="SelectedContent"/></ControlTemplate></TabControl.Template>
        <TabItem Header="Обзор"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
          <TextBlock Text="Порядок под защитой." Style="{StaticResource Heading}"/>
          <TextBlock Text="Меньше лишнего. Больше контроля." Style="{StaticResource Sub}" Margin="0,0,0,28"/>
          <Border Style="{StaticResource Card}" Padding="30" Margin="0,0,0,18"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="СОСТОЯНИЕ ЗАЩИТЫ" FontSize="10" Foreground="{StaticResource Accent}" Margin="0,0,0,15"/><TextBlock x:Name="ProtectionTitle" Text="Проверяю Microsoft Defender…" FontFamily="Georgia" FontSize="25"/><TextBlock x:Name="ProtectionDescription" Style="{StaticResource Sub}" Text="Получаю реальное состояние защиты Windows." Margin="0,10,20,0" MaxWidth="540" HorizontalAlignment="Left"/></StackPanel><Button Grid.Column="1" Content="Проверить файлы  →" VerticalAlignment="Center" Style="{StaticResource Primary}" Tag="1" Click="Navigate"/></Grid></Border>
          <UniformGrid Columns="3" Margin="0,0,0,24">
            <Border Style="{StaticResource Card}" Margin="0,0,10,0"><StackPanel><TextBlock Text="ЗАГРУЗКИ" FontSize="10" Foreground="{StaticResource Muted}"/><TextBlock x:Name="WatchState" Text="Выключено" FontFamily="Georgia" FontSize="21" Margin="0,15,0,8"/><TextBlock Text="Проверка новых файлов" Style="{StaticResource Sub}"/></StackPanel></Border>
            <Border Style="{StaticResource Card}" Margin="0,0,10,0"><StackPanel><TextBlock Text="ОЧИСТКА ЗА СЕАНС" FontSize="10" Foreground="{StaticResource Muted}"/><TextBlock x:Name="FreedState" Text="0 Б" FontFamily="Georgia" FontSize="25" Margin="0,12,0,8"/><TextBlock Text="Освобождено по запросу" Style="{StaticResource Sub}"/></StackPanel></Border>
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="КАРАНТИН" FontSize="10" Foreground="{StaticResource Muted}"/><TextBlock x:Name="VaultState" Text="—" FontFamily="Georgia" FontSize="25" Margin="0,12,0,8"/><TextBlock Text="Изолировано файлов" Style="{StaticResource Sub}"/></StackPanel></Border>
          </UniformGrid>
          <TextBlock Text="Последние действия" FontFamily="Georgia" FontSize="21" Margin="0,0,0,14"/>
          <Border Style="{StaticResource Card}" Padding="18"><ListBox x:Name="ActivityList" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Ink}" MaxHeight="180" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,5" Foreground="{StaticResource Muted}"/></DataTemplate></ListBox.ItemTemplate></ListBox></Border>
          <TextBlock Text="HERMES выполняет изменения только после твоего подтверждения." Style="{StaticResource Sub}" Margin="0,18,0,10"/>
        </StackPanel></ScrollViewer></TabItem>
        <TabItem Header="Антивирус"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel><TextBlock Text="Невидимое — на виду." Style="{StaticResource Heading}"/><TextBlock Text="Проверка обычных и скрытых файлов движком Microsoft Defender. Без автоматического удаления со стороны HERMES." Style="{StaticResource Sub}" Margin="0,0,0,20"/></StackPanel>
          <WrapPanel Grid.Row="1" x:Name="ScanActions"><Button Content="Проверить файл" Style="{StaticResource Primary}" Click="ScanFile"/><Button Content="Проверить папку" Click="ScanFolder"/><Button Content="Проверить загрузки" Click="ScanDownloads"/></WrapPanel>
          <StackPanel Grid.Row="2"><CheckBox x:Name="WatchCheck" Content="Проверять новые файлы в загрузках, пока HERMES открыт" Checked="ToggleWatch" Unchecked="ToggleWatch"/><TextBlock x:Name="DownloadPathText" Style="{StaticResource Sub}" Margin="0,0,0,15"/></StackPanel>
          <DataGrid Grid.Row="3" x:Name="ScanGrid" SelectionMode="Single" SelectionChanged="ScanSelectionChanged"><DataGrid.Columns><DataGridTextColumn Header="Файл / папка" Binding="{Binding Path}" Width="*"/><DataGridTextColumn Header="Результат" Binding="{Binding Verdict}" Width="220"/></DataGrid.Columns></DataGrid>
          <StackPanel Grid.Row="4" Margin="0,15,0,0"><WrapPanel><Button Content="Подробности" Click="ScanDetails"/><Button Content="Изолировать выбранный файл…" Click="QuarantineSelected"/></WrapPanel><TextBlock Text="Наблюдение начинается после появления файла на диске и не блокирует скачивание в браузере. Защита Windows может действовать независимо от HERMES." Style="{StaticResource Sub}"/></StackPanel>
        </Grid></TabItem>
        <TabItem Header="Очистка"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel><TextBlock Text="Оставить необходимое." Style="{StaticResource Heading}"/><TextBlock Text="Временные файлы и кэш браузеров старше суток. Документы, пароли и история браузера не входят в очистку." Style="{StaticResource Sub}" Margin="0,0,0,20"/></StackPanel>
          <WrapPanel Grid.Row="1"><Button x:Name="CleanupScanButton" Content="Найти мусор" Style="{StaticResource Primary}" Click="ScanCleanup"/><Button x:Name="CleanupDeleteButton" Content="Удалить выбранное…" Click="DeleteCleanup"/><TextBlock x:Name="CleanupSummary" Text="Сначала выполни поиск" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Margin="0,0,0,10"/></WrapPanel>
          <DataGrid Grid.Row="2" x:Name="CleanupGrid" SelectionMode="Extended"><DataGrid.Columns><DataGridTextColumn Header="Категория" Binding="{Binding Category}" Width="140"/><DataGridTextColumn Header="Файл" Binding="{Binding Path}" Width="*"/><DataGridTextColumn Header="Размер" Binding="{Binding Size}" Width="105"/></DataGrid.Columns></DataGrid>
          <TextBlock Grid.Row="3" Text="Выдели нужные строки (Ctrl / Shift). Перед удалением будет показан объём и запрошено согласие. Файлы в использовании пропускаются." Style="{StaticResource Sub}" Margin="0,16,0,0"/>
        </Grid></TabItem>
        <TabItem Header="Процессы"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel><TextBlock Text="Ресурсы под контролем." Style="{StaticResource Heading}"/><TextBlock Text="Реальные процессы Windows, отсортированные по памяти. Выбирай ненужное сам — системные задачи защищены." Style="{StaticResource Sub}" Margin="0,0,0,20"/></StackPanel>
          <WrapPanel Grid.Row="1"><Button x:Name="ProcessesRefreshButton" Content="Обновить список" Style="{StaticResource Primary}" Click="RefreshProcesses"/><Button x:Name="ProcessCloseButton" Content="Закрыть приложение…" Click="CloseProcess"/><Button x:Name="ProcessKillButton" Content="Завершить принудительно…" Click="KillProcess"/></WrapPanel>
          <DataGrid Grid.Row="2" x:Name="ProcessGrid" SelectionMode="Single"><DataGrid.Columns><DataGridTextColumn Header="Приложение" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="PID" Binding="{Binding Id}" Width="75"/><DataGridTextColumn Header="Память" Binding="{Binding Memory}" Width="115"/><DataGridTextColumn Header="Доступность" Binding="{Binding Status}" Width="230"/></DataGrid.Columns></DataGrid>
          <TextBlock Grid.Row="3" Text="Закрытие приложений может освободить память. Принудительное завершение приводит к потере несохранённых данных; ускорение не гарантируется." Style="{StaticResource Sub}" Margin="0,16,0,0"/>
        </Grid></TabItem>
        <TabItem Header="Карантин"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel><TextBlock Text="За закрытой дверью." Style="{StaticResource Heading}"/><TextBlock Text="Изолированные файлы хранятся в зашифрованном виде. Восстанавливай их только если уверен в безопасности." Style="{StaticResource Sub}" Margin="0,0,0,20"/></StackPanel>
          <WrapPanel Grid.Row="1"><Button Content="Обновить карантин" Click="RefreshVault"/><Button x:Name="RestoreButton" Content="Восстановить выбранный файл…" Click="RestoreSelected"/></WrapPanel>
          <DataGrid Grid.Row="2" x:Name="VaultGrid" SelectionMode="Single"><DataGrid.Columns><DataGridTextColumn Header="Исходный путь" Binding="{Binding OriginalPath}" Width="*"/><DataGridTextColumn Header="Изолирован" Binding="{Binding Date}" Width="180"/></DataGrid.Columns></DataGrid>
          <TextBlock Grid.Row="3" Text="В карантин попадают только файлы, выбранные и подтверждённые тобой. Восстановление не запускает файл." Style="{StaticResource Sub}" Margin="0,16,0,0"/>
        </Grid></TabItem>
      </TabControl>
      <Grid Grid.Row="2" Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><ProgressBar x:Name="BusyProgress" Height="2" IsIndeterminate="True" Foreground="{StaticResource Accent}" Background="#262B26" Visibility="Collapsed" Margin="0,0,0,10"/><TextBlock x:Name="StatusText" Text="Готов к работе" Style="{StaticResource Sub}"/></StackPanel><Button x:Name="CancelButton" Grid.Column="1" Content="Отменить" Click="CancelOperation" Visibility="Collapsed" Margin="12,0,0,0" Padding="14,6"/></Grid>
    </Grid>
  </Grid>
</Window>
